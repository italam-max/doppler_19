<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Soporte: IT, Calidad y Dirección ven los tickets de todas las mesas -->
    <record id="group_helpdesk_all_teams" model="res.groups">
        <field name="name">Soporte: ver todas las mesas</field>
        <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
        <field name="comment">IT, Calidad y Dirección. El resto solo ve sus propios tickets.</field>
    </record>

    <!-- Tiempo personal: RH, IT y Dirección pueden usar todos los tipos -->
    <record id="group_leave_all_types" model="res.groups">
        <field name="name">Tiempo personal: todos los tipos</field>
        <field name="comment">Pueden registrar cualquier tipo de tiempo personal, incluidos los marcados "Solo RH".</field>
    </record>

    <!-- Precios y costos de producto. Sustituyen a los grupos de 16 que no llegaron a 19:
         doppler.group_can_see_prices y sale_order_invoice.group_sale_price_unit_user
         (tenían los mismos usuarios y las vistas los usaban juntos), y
         doppler.group_can_see_product_cost. Nacen vacíos: los usuarios se asignan con
         _data_recovery/recovery_grupos_precios.py y desde Ajustes > Usuarios. -->
    <record id="group_can_see_prices" model="res.groups">
        <field name="name">Alamex: Puede ver precios</field>
        <field name="comment">Ve precio de venta y, en las vistas de producto personalizadas, también el costo.</field>
    </record>

    <record id="group_can_see_product_cost" model="res.groups">
        <field name="name">Alamex: Puede ver costo de producto</field>
        <field name="comment">Ve el costo de producto en las vistas que lo restringen a este grupo.</field>
    </record>
</odoo>
