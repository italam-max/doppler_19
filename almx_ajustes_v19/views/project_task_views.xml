<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secciones "Fechas y estatus" y "Documentos" de la tarea, como en 16
         (estaban en almx_project, deprecado para 19). Los campos son de Studio
         y sus datos ya están en 19; solo faltaba la vista. -->
    <record id="view_task_form_almx_fechas_documentos" model="ir.ui.view">
        <field name="name">project.task.form.almx.fechas.documentos</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Fechas y estatus" name="almx_fechas_estatus">
                    <group>
                        <field name="x_studio_fecha_efectiva_de_inicio"/>
                        <field name="x_studio_fecha_efectiva_de_terminacin"/>
                        <field name="x_studio_prioridad"/>
                    </group>
                    <group>
                        <field name="x_studio_pagado_1"/>
                        <field name="x_studio_aprobacin_de_calidad"/>
                        <field name="x_studio_aprobacin_de_calidad_con_reinspeccin"/>
                    </group>
                </group>
                <group string="Documentos" name="almx_documentos">
                    <group>
                        <field name="x_studio_inspeccin"/>
                        <field name="x_studio_cronograma_de_instalacin" filename="x_studio_cronograma_de_instalacin_filename"/>
                        <field name="x_studio_cronograma_de_instalacin_filename" invisible="1"/>
                        <field name="x_studio_" filename="x_studio__filename"/>
                        <field name="x_studio__filename" invisible="1"/>
                        <field name="end_guides"/>
                        <field name="x_studio_guas_terminadas" filename="x_studio_guas_terminadas_filename"/>
                        <field name="x_studio_guas_terminadas_filename" invisible="1"/>
                        <field name="x_studio_guas_terminadas_1" filename="x_studio_guas_terminadas_1_filename"/>
                        <field name="x_studio_guas_terminadas_1_filename" invisible="1"/>
                        <field name="x_studio_guas_terminadas_2" filename="x_studio_guas_terminadas_2_filename"/>
                        <field name="x_studio_guas_terminadas_2_filename" invisible="1"/>
                        <field name="x_studio_guas_terminadas_3" filename="x_studio_guas_terminadas_3_filename"/>
                        <field name="x_studio_guas_terminadas_3_filename" invisible="1"/>
                        <field name="x_studio_guas_terminadas_4" filename="x_studio_guas_terminadas_4_filename"/>
                        <field name="x_studio_guas_terminadas_4_filename" invisible="1"/>
                        <field name="x_studio_guas_modificadas"/>
                        <field name="x_studio_nmero_de_revisin"/>
                        <field name="x_studio_guas_en_revisin"/>
                        <field name="x_studio_guas_modificadas_1" filename="x_studio_guas_modificadas_1_filename"/>
                        <field name="x_studio_guas_modificadas_1_filename" invisible="1"/>
                        <field name="x_studio_guas_modificadas_2" filename="x_studio_guas_modificadas_2_filename"/>
                        <field name="x_studio_guas_modificadas_2_filename" invisible="1"/>
                        <field name="x_studio_guas_modificadas_3" filename="x_studio_guas_modificadas_3_filename"/>
                        <field name="x_studio_guas_modificadas_3_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="x_studio_guas_aprobadas_por_el_cliente" filename="x_studio_guas_aprobadas_por_el_cliente_filename"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_filename" invisible="1"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_1" filename="x_studio_guas_aprobadas_por_el_cliente_1_filename"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_1_filename" invisible="1"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_2" filename="x_studio_guas_aprobadas_por_el_cliente_2_filename"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_2_filename" invisible="1"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_3" filename="x_studio_guas_aprobadas_por_el_cliente_3_filename"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_3_filename" invisible="1"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_4" filename="x_studio_guas_aprobadas_por_el_cliente_4_filename"/>
                        <field name="x_studio_guas_aprobadas_por_el_cliente_4_filename" invisible="1"/>
                        <field name="x_studio_archivo_editable"/>
                        <field name="x_studio_guas_proveedor_1" filename="x_studio_guas_proveedor_1_filename"/>
                        <field name="x_studio_guas_proveedor_1_filename" invisible="1"/>
                        <field name="x_studio_guas_aprobadas_por_cliente_url" widget="url"/>
                        <field name="x_studio_guas_de_proveedor_url" widget="url"/>
                        <field name="x_studio_guas_de_montador_url" widget="url"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
