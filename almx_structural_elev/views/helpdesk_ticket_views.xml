<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.almx.structural</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <field name="priority" position="after">
                <field name="almx_show_structural_dates" invisible="1"/>
                <field name="start_date" invisible="not almx_show_structural_dates"/>
                <field name="effective_date" invisible="not almx_show_structural_dates"/>
                <field name="end_date" invisible="not almx_show_structural_dates"/>
            </field>
        </field>
    </record>

    <record id="helpdesk_team_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.team.form.almx.structural</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="almx_structural_dates"/>
            </field>
        </field>
    </record>

</odoo>
