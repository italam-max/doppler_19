<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- En 19 los grupos se agrupan por privilegio (res.groups.privilege), ya no por category_id -->
    <record id="res_groups_privilege_process_op" model="res.groups.privilege">
        <field name="name">Seguimiento de Proceso OP</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_monitoring_process_op" model="res.groups">
        <field name="name">Seguimiento de Proceso OP</field>
        <field name="privilege_id" ref="res_groups_privilege_process_op"/>
        <field name="comment">Ve y marca si una solicitud de aprobación siguió o no el proceso.</field>
    </record>
</odoo>
