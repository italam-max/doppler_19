<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cfdi_timbrado_guard" model="ir.ui.view">
        <field name="name">account.move.form.almx.cfdi.timbrado.guard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="almx_bloquear_envio" invisible="1"/>
            </xpath>
            <!-- 19 trae dos botones Enviar: se conserva la condición nativa de cada uno -->
            <xpath expr="//header/button[@name='action_invoice_sent' and contains(@class, 'oe_highlight')]" position="attributes">
                <attribute name="invisible">not display_send_button or not highlight_send_button or almx_bloquear_envio</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_invoice_sent' and not(@class)]" position="attributes">
                <attribute name="invisible">not display_send_button or highlight_send_button or almx_bloquear_envio</attribute>
            </xpath>
        </field>
    </record>
</odoo>
