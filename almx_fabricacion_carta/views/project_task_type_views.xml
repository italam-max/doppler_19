<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_type_edit_carta" model="ir.ui.view">
        <field name="name">project.task.type.form.almx.carta</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <field name="fold" position="after">
                <field name="almx_carta_code"/>
                <field name="almx_carta_origin_stage_ids" widget="many2many_tags"
                       invisible="not almx_carta_code" required="almx_carta_code"/>
            </field>
        </field>
    </record>
</odoo>
