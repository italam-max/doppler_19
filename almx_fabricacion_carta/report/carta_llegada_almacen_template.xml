<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Template QWeb: Notificacion de Llegada de Equipo a Almacen — MEX-OPE-ANX-09

    Mismo criterio de diseño que report_carta_fabricacion_content y
    report_carta_termino_fabricacion_content (ver ese archivo para el
    detalle del watermark/franja con position: fixed).

    Mapeo de los campos editables del formato oficial (Guia de Llenado B
    del PDF MEX-OPE-ANX-09) a los datos de la tarea:
      1. Fecha (emision)             -> fecha_emision (hoy)
      2. Fecha de entrada al Almacen -> fecha_emision (mismo dia en que
                                         la tarea entra a la etapa
                                         CHECK Y ALMACEN)
      3. Nombre completo y firma     -> task.user_ids (Supervisor de
                                         Operaciones), igual que en las
                                         otras dos cartas.

    Campo agregado por Sammer (no viene en el formato oficial original,
    se añade debajo de "Fecha de llegada a almacén"):
      SO DE REFERENCIA -> task.sale_order_id.name

    Autor  : Irving Sammer Gonzalez Correa
    Version: 16.0.2.0.1
-->
<template id="report_carta_llegada_almacen_content">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="task">
            <div class="page" style="
                font-family: Arial, sans-serif;
                font-size: 10pt;
                color: #000000;
                margin: 0;
                padding: 0;
                position: relative;
            ">

                <!-- ============================================================
                     FONDO: watermark centrado (detras del contenido)
                ============================================================ -->
                <div style="
                    position: fixed;
                    top: 260px;
                    left: 0;
                    width: 100%;
                    text-align: center;
                ">
                    <img src="/almx_fabricacion_carta/static/src/img/alamex_watermark.png"
                         style="width: 65%; opacity: 0.55;"/>
                </div>

                <!-- ============================================================
                     FONDO: franja curva del pie, anclada al borde real
                     inferior de la hoja, ancho completo.
                ============================================================ -->
                <div style="
                    position: fixed;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                ">
                    <img src="/almx_fabricacion_carta/static/src/img/alamex_footer_band.png"
                         style="width: 100%; display: block;"/>
                </div>

                <!-- ============================================================
                     CONTENIDO REAL — se pinta por encima del fondo
                ============================================================ -->
                <div style="position: relative;">

                    <!-- ENCABEZADO -->
                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 24px;
                        border: 1.5px solid #003087;
                        background-color: #ffffff;
                    ">
                        <tr>
                            <td style="
                                width: 18%;
                                border-right: 1.5px solid #003087;
                                padding: 6px 10px;
                                vertical-align: middle;
                                text-align: center;
                            ">
                                <img src="/almx_fabricacion_carta/static/src/img/alamex_logo.png"
                                     style="max-height: 42px; max-width: 90px;"
                                     alt="ALAMEX"/>
                            </td>
                            <td style="
                                width: 52%;
                                border-right: 1.5px solid #003087;
                                padding: 0;
                                vertical-align: middle;
                            ">
                                <div style="
                                    background-color: #003087;
                                    color: #ffffff;
                                    font-weight: bold;
                                    text-align: center;
                                    padding: 4px 6px;
                                    font-size: 9pt;
                                    border-bottom: 1px solid #003087;
                                ">OPERACIONES</div>
                                <div style="
                                    text-align: center;
                                    padding: 6px;
                                    font-size: 9pt;
                                    font-weight: bold;
                                    line-height: 1.3;
                                ">Carta de Notificación de Llegada de<br/>Equipo a Almacén</div>
                            </td>
                            <td style="
                                width: 30%;
                                padding: 0;
                                vertical-align: top;
                                font-size: 8.5pt;
                            ">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="
                                            background-color: #003087;
                                            color: #ffffff;
                                            font-weight: bold;
                                            padding: 3px 6px;
                                            border-bottom: 1px solid #c8c8c8;
                                            width: 50%;
                                        ">Clave:</td>
                                        <td style="
                                            padding: 3px 6px;
                                            border-bottom: 1px solid #c8c8c8;
                                        ">MEX-OPE-ANX-09</td>
                                    </tr>
                                    <tr>
                                        <td style="
                                            background-color: #003087;
                                            color: #ffffff;
                                            font-weight: bold;
                                            padding: 3px 6px;
                                            border-bottom: 1px solid #c8c8c8;
                                        ">Versión:</td>
                                        <td style="
                                            padding: 3px 6px;
                                            border-bottom: 1px solid #c8c8c8;
                                        ">00</td>
                                    </tr>
                                    <tr>
                                        <td style="
                                            background-color: #003087;
                                            color: #ffffff;
                                            font-weight: bold;
                                            padding: 3px 6px;
                                        ">Actualización:</td>
                                        <td style="padding: 3px 6px;">Julio - 26</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- TITULO -->
                    <p style="
                        text-align: center;
                        font-weight: bold;
                        font-size: 12pt;
                        letter-spacing: 0.5px;
                        margin: 28px 0 36px 0;
                    ">NOTIFICACION DE LLEGADA EQUIPO AL ALMACEN</p>

                    <!-- FECHA (campo 1: fecha de emision) -->
                    <t t-set="fecha_doc"
                       t-value="task.almx_carta_almacen_fecha or datetime.date.today()"/>
                    <p style="text-align: right; margin: 0 0 36px 0;">
                        Fecha:
                        <span t-out="fecha_doc.strftime('%d/%m/%Y')"/>
                    </p>

                    <!-- CUERPO -->
                    <p style="margin: 0 0 18px 0;">A quien corresponda:</p>

                    <p style="text-align: justify; margin: 0 0 14px 0;">
                        Por medio de la presente, hacemos de su conocimiento que el equipo
                        correspondiente al pedido, proyecto u orden de compra indicada en este
                        documento ha sido recibido en nuestro almacén, quedando bajo resguardo
                        conforme a los procesos internos de recepción, identificación y control
                        documental.
                    </p>

                    <p style="text-align: justify; margin: 0 0 24px 0;">
                        La presente notificación tiene carácter informativo y se emite para
                        confirmar la llegada física del material, así como para facilitar la
                        coordinación de los siguientes pasos relacionados con revisión,
                        liberación, entrega, retiro o programación logística, según corresponda.
                    </p>

                    <!-- Campo 2: fecha de entrada al almacen -->
                    <p style="margin: 0 0 4px 0;">
                        Fecha de llegada a almacén:
                        <span t-out="fecha_doc.strftime('%d/%m/%Y')"/>
                    </p>

                    <!-- Campo agregado por Sammer: SO de referencia -->
                    <t t-set="numero_orden"
                       t-value="task.sale_order_id.name if task.sale_order_id else ''"/>
                    <p style="margin: 0 0 24px 0;">
                        SO DE REFERENCIA:
                        <span t-out="numero_orden"/>
                    </p>

                    <p style="text-align: justify; margin: 0 0 14px 0;">
                        Agradecemos confirmar la recepción de esta notificación y, en su caso,
                        indicar las instrucciones correspondientes para la programación de
                        entrega, retiro, inspección o siguiente etapa del proceso.
                    </p>

                    <p style="text-align: justify; margin: 0 0 48px 0;">
                        Sin más por el momento, quedamos atentos a cualquier comentario o
                        instrucción adicional.
                    </p>

                    <!-- FIRMA — sin linea, documento generado automaticamente -->
                    <p style="margin: 0 0 60px 0;">Atentamente,</p>

                    <div style="text-align: center;">
                        <t t-set="supervisor_txt"
                           t-value="', '.join(task.user_ids.mapped('name')) if task.user_ids else 'Sin asignar'"/>
                        <p style="margin: 0; font-weight: bold;">
                            <t t-out="supervisor_txt"/>
                        </p>
                        <p style="margin: 4px 0 0 0;">Supervisor de Operaciones</p>
                    </div>

                </div>
                <!-- /contenido real -->

            </div>
        </t>
    </t>
</template>

</odoo>
