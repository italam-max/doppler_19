<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            ALMX FIX (autoenlace PICK/OUT automáticos, sep 2026):
            Enlaza related_pick_id/related_out_id para los PICK/OUT que
            genera automáticamente el motor de aprovisionamiento nativo
            de Odoo (no usa el botón manual "Crear OUT"/"Crear INT").
            Corre cada 10 minutos; cada corrida solo revisa lo creado en
            los últimos 7 días (parámetro 'days' de la llamada), así que
            es una consulta acotada y rápida. Ver el comentario extenso
            en models/stock.py (_cron_almx_autolink_related_ids) para el
            porqué de usar un cron en vez de create()/write().
        -->
        <record id="ir_cron_almx_autolink_related_ids" model="ir.cron">
            <field name="name">Alamex: autoenlace PICK/OUT automáticos (related_pick_id/related_out_id)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._cron_almx_autolink_related_ids()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
