<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_almx" model="ir.ui.view">
        <field name="name">delivery.carrier.form.almx_metodo_envio</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <field name="almx_shipping_kind"/>
            </field>
        </field>
    </record>
    <record id="view_delivery_carrier_tree_almx" model="ir.ui.view">
        <field name="name">delivery.carrier.list.almx_metodo_envio</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="almx_shipping_kind" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
