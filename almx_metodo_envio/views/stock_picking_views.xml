<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_almx_metodo_envio" model="ir.ui.view">
        <field name="name">stock.picking.form.almx_metodo_envio</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Envío en la columna izquierda, debajo de las ubicaciones, leído de la venta. -->
            <xpath expr="//field[@name='location_dest_id']/.." position="inside">
                <field name="almx_shipping_kind" invisible="1"/>
                <field name="almx_carrier_id" invisible="not sale_id" options="{'no_open': True}"/>
                <field name="almx_collect_date" invisible="not sale_id or not almx_collect_date"/>
                <field name="almx_paqueteria" invisible="almx_shipping_kind != 'paqueteria'"/>
                <field name="almx_paqueteria_otra" invisible="almx_shipping_kind != 'paqueteria' or almx_paqueteria != 'otra'"/>
                <field name="almx_tipo_servicio" invisible="almx_shipping_kind != 'paqueteria'"/>
                <field name="almx_sucursal_destino" invisible="almx_shipping_kind != 'paqueteria' or not almx_sucursal_destino"/>
                <field name="almx_contacto_nombre" invisible="almx_shipping_kind != 'flete'"/>
                <field name="almx_contacto_telefono" widget="phone" invisible="almx_shipping_kind != 'flete'"/>
                <field name="almx_app_servicio" invisible="almx_shipping_kind != 'app'"/>
                <field name="almx_app_otra" invisible="almx_shipping_kind != 'app' or almx_app_servicio != 'otra'"/>
                <field name="almx_app_referencia" invisible="almx_shipping_kind != 'app'"/>
                <field name="almx_shipping_address" widget="text" invisible="almx_shipping_kind not in ('paqueteria', 'flete')"/>
            </xpath>
            <!-- Los campos de almx_stock en la columna derecha se ocultan cuando el traslado viene de una venta. -->
            <xpath expr="//field[@name='carrier_id'][@readonly='1']" position="attributes">
                <attribute name="invisible">sale_id</attribute>
            </xpath>
            <xpath expr="//field[@name='collect_date']" position="attributes">
                <attribute name="invisible">sale_id or not is_immediate</attribute>
            </xpath>
        </field>
    </record>
</odoo>
