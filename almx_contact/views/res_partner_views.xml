<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="alamex_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.almx.categoria</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- En 16 anclaba en l10n_mx_edi_curp, que en 19 no está en la vista base -->
            <field name="vat" position="after">
                <field name="x_studio_categoria_comercial" required="1"/>
            </field>
        </field>
    </record>

    <record id="alamex_res_partner_search" model="ir.ui.view">
        <field name="name">res.partner.search.almx.categoria</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter name="groupby_categoria_comercial" string="Categoría comercial"
                        context="{'group_by': 'x_studio_categoria_comercial'}"/>
            </search>
        </field>
    </record>
</odoo>
