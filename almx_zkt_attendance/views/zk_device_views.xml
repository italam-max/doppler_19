<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zk_device_tree" model="ir.ui.view">
        <field name="name">zk.device.tree</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="tz"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_sync_datetime" type="object"
                                string="Sincronizar fecha/hora en el equipo"
                                class="oe_stat_button" icon="fa-clock-o"
                                confirm="Se encolará un comando para forzar la fecha/hora local en este equipo. Se enviará en el siguiente polling del equipo (normalmente segundos). ¿Continuar?"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="tz"/>
                        </group>
                        <group>
                            <field name="location_note"/>
                            <field name="allowed_ips" placeholder="Vacío = cualquier IP"/>
                            <field name="last_seen"/>
                            <field name="last_attlog_stamp"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comandos ADMS">
                            <field name="command_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Creado"/>
                                    <field name="command"/>
                                    <field name="state"/>
                                    <field name="seq"/>
                                    <field name="sent_date"/>
                                    <field name="ack_date"/>
                                    <field name="raw_ack"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zk_device" model="ir.actions.act_window">
        <field name="name">Terminales ZKTeco</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra aquí cada terminal ZKTeco autorizada a enviar checadas.
            </p>
            <p>
                El número de serie (SN) se consulta en el equipo, en el menú de
                Información del Sistema o en Comm &gt; Ethernet.
            </p>
        </field>
    </record>

    <menuitem id="menu_zk_device_root"
              name="Terminales ZKTeco"
              parent="hr.menu_human_resources_configuration"
              action="action_zk_device"
              sequence="50"/>

</odoo>
