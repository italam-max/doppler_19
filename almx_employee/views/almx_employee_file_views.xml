<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="almx_employee_file_view_list" model="ir.ui.view">
        <field name="name">almx.employee.file.list</field>
        <field name="model">almx.employee.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="event_type"/>
                <field name="reference_employee_id" optional="show"/>
                <field name="description" optional="show"/>
                <field name="attachment_filename" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="almx_employee_file_view_form" model="ir.ui.view">
        <field name="name">almx.employee.file.form</field>
        <field name="model">almx.employee.file</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="event_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="reference_employee_id"/>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción del evento"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="almx_employee_file_view_search" model="ir.ui.view">
        <field name="name">almx.employee.file.search</field>
        <field name="model">almx.employee.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="event_type"/>
                <group>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_event" string="Evento" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="almx_employee_file_action" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">almx.employee.file</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="almx_employee_file_menu" name="Expedientes"
              parent="hr.menu_hr_employee_payroll" action="almx_employee_file_action"
              groups="hr.group_hr_user" sequence="30"/>
</odoo>
