<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_almx_import" model="ir.ui.view">
        <field name="name">purchase.order.form.almx.import</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="almx_is_import" readonly="state in ('done', 'cancel')"/>
            </field>

            <xpath expr="(//field[@name='currency_id'])[1]" position="after">
                <xpath expr="//field[@name='incoterm_id']" position="move"/>
                <xpath expr="//field[@name='incoterm_location']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
