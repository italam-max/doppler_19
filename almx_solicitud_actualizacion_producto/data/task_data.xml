<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="task_sku" model="almx.product.update.task">
            <field name="sequence">10</field>
            <field name="name">Verificación de SKU</field>
            <field name="deadline_days">3</field>
            <field name="note">Verificar y actualizar el SKU del producto. Incluir referencia de búsqueda correspondiente.</field>
        </record>
        <record id="task_fotos" model="almx.product.update.task">
            <field name="sequence">20</field>
            <field name="name">Fotografías del Producto</field>
            <field name="deadline_days">5</field>
            <field name="note">Tomar y cargar las fotografías oficiales del producto en el sistema.</field>
        </record>
        <record id="task_sat" model="almx.product.update.task">
            <field name="sequence">30</field>
            <field name="name">Código SAT</field>
            <field name="deadline_days">3</field>
            <field name="note">Verificar y actualizar el código SAT correspondiente al producto.</field>
        </record>
        <record id="task_ficha_interna" model="almx.product.update.task">
            <field name="sequence">40</field>
            <field name="name">Solicitud de Ficha Técnica (Interna)</field>
            <field name="deadline_days">3</field>
            <field name="note">Gestionar internamente la obtención de la ficha técnica del producto.</field>
        </record>
        <record id="task_ficha_proveedor" model="almx.product.update.task">
            <field name="sequence">50</field>
            <field name="name">Solicitar Ficha Técnica al Proveedor</field>
            <field name="deadline_days">5</field>
            <field name="note">Contactar al proveedor y solicitar la ficha técnica oficial del producto.</field>
        </record>
        <record id="task_calidad" model="almx.product.update.task">
            <field name="sequence">60</field>
            <field name="name">Puntos de Control de Calidad</field>
            <field name="deadline_days">7</field>
            <field name="note">Definir y registrar los puntos de control de calidad para este producto.</field>
        </record>
    </data>
</odoo>
