<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_purchase_button" model="ir.ui.view">
        <field name="name">product.template.form.solicitud.actualizacion</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_solicitar_actualizacion_producto" type="object"
                        string="Solicitar Actualización" icon="fa-refresh" class="oe_stat_button"
                        groups="purchase.group_purchase_user"
                        help="Crea las actividades de actualización para cada área responsable"/>
            </xpath>
        </field>
    </record>
</odoo>
