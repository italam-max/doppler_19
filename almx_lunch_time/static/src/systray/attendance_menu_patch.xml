<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="hr_attendance.attendance_menu" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_att_menu_container')]" position="inside">
        <button t-if="state.attendanceState === 'checked_in' and !state.gettingPosition"
                t-on-click="() => this.lunchAction('lunch_start')"
                class="btn btn-info">
            <span>Lunch Start</span>
            <i class="fa fa-cutlery ms-1"/>
        </button>
        <button t-if="state.attendanceState === 'lunch_start' and !state.gettingPosition"
                t-on-click="() => this.lunchAction('lunch_end')"
                class="btn btn-info">
            <span>Lunch End</span>
            <i class="fa fa-cutlery ms-1"/>
        </button>
    </xpath>
</t>

</templates>
