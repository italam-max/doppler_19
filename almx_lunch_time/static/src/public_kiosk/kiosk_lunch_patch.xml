<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Pantalla de acciones (almuerzo / salida) -->
    <t t-name="almx_lunch_time.KioskLunchActions">
        <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 justify-content-center align-items-center">
            <div class="card rounded-3">
                <div class="card-body rounded-3 text-center p-4">
                    <t t-call="hr_attendance.EmployeeBadge">
                        <t t-set="employeeAvatar" t-value="props.employeeData.employee_avatar"/>
                        <t t-set="employeeAvatarHeight" t-value="'90'"/>
                    </t>
                    <h3 class="mt-2 mb-1"><t t-esc="props.employeeData.employee_name"/></h3>
                    <h5 class="text-muted mb-4">What do you want to do?</h5>
                    <div class="d-flex flex-column gap-3">
                        <button t-if="state === 'checked_in'"
                                class="btn btn-warning btn-lg px-5 py-3"
                                t-on-click="() => props.onLunchAction('lunch_start')">
                            <i class="fa fa-2x fa-cutlery align-middle me-3"/>
                            <span class="align-middle fs-3">Lunch Start</span>
                        </button>
                        <button t-if="state === 'lunch_start'"
                                class="btn btn-warning btn-lg px-5 py-3"
                                t-on-click="() => props.onLunchAction('lunch_end')">
                            <i class="fa fa-2x fa-cutlery align-middle me-3"/>
                            <span class="align-middle fs-3">Lunch End</span>
                        </button>
                        <button t-if="state === 'checked_in' or state === 'lunch_end'"
                                class="btn btn-primary btn-lg px-5 py-3"
                                t-on-click="() => props.onLunchAction('check_out')">
                            <i class="fa fa-2x fa-sign-out align-middle me-3"/>
                            <span class="align-middle fs-3">Check OUT</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="o_hr_kiosk_mode_bottom my-4 mx-auto">
            <button class="btn btn-light btn-lg rounded-pill px-5" t-on-click="() => props.onClickBack()">
                <i class="oi oi-chevron-left me-2"/>
                <span>Go back</span>
            </button>
        </div>
    </t>

    <!-- Registrar la nueva pantalla en la app del kiosko -->
    <t t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">
        <xpath expr="//t[@t-if=&quot;this.state.active_display === 'pin'&quot;]" position="after">
            <t t-if="this.state.active_display === 'lunch'">
                <KioskLunchActions
                    employeeData="this.employeeData"
                    onLunchAction="(action) => this.onLunchAction(action)"
                    onClickBack="() => this.kioskReturn()"/>
            </t>
        </xpath>
    </t>

    <!-- Pantalla de PIN: texto según la acción elegida -->
    <t t-inherit="hr_attendance.KioskPinConfirm" t-inherit-mode="extension">
        <xpath expr="//h5[hasclass('text-muted')]" position="replace">
            <h5 class="text-muted my-0">
                Please enter your PIN to <t t-esc="actionLabel"/>
            </h5>
        </xpath>
    </t>

    <!-- Saludo: mensaje específico para inicio/fin de almuerzo -->
    <t t-inherit="hr_attendance.public_kiosk_greetings" t-inherit-mode="extension">
        <xpath expr="//h5[hasclass('text-muted')]" position="replace">
            <h5 class="text-muted mt-2 mb-0">
                <t t-if="this.lunchAction">Lunch</t>
                <t t-elif="attendance.check_out">Goodbye</t>
                <t t-else="">Welcome</t>
            </h5>
        </xpath>
        <xpath expr="//div[hasclass('o_hr_attendance_kiosk_card_bottom')]/div[hasclass('alert')]" position="attributes">
            <attribute name="t-if">!this.lunchAction</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_hr_attendance_kiosk_card_bottom')]/div[hasclass('alert')]" position="before">
            <div t-if="this.lunchAction" class="alert alert-info text-center p-3" role="status">
                <t t-if="this.lunchAction === 'lunch_start'">Lunch started at</t>
                <t t-else="">Lunch ended at</t>
                <strong><t t-esc="this.lunchTime"/></strong>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_hr_attendance_kiosk_card_bottom')]/div[hasclass('d-flex')]" position="attributes">
            <attribute name="t-if">!this.lunchAction</attribute>
        </xpath>
    </t>

</templates>
