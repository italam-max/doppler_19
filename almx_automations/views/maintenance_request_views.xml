<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_request_form_sale_line" model="ir.ui.view">
        <field name="name">maintenance.request.form.almx.sale.line</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <field name="maintenance_team_id" position="after">
                <field name="x_studio_field_ypPfL" readonly="1"/>
                <field name="x_studio_field_UT6zf" readonly="1" options="{'no_open': False}"/>
            </field>
        </field>
    </record>

    <!-- Borra la vista equivalente creada en caliente (3-nov) para no duplicarla. -->
    <delete model="ir.ui.view" search="[('name', '=', 'almx.maintenance.request.search.pedido_venta')]"/>
    <!-- Busqueda por numero de venta en Peticiones de mantenimiento (nov 2026).
         Sustituye la vista en caliente id 14123. -->
    <record id="maintenance_request_search_almx_pedido_venta" model="ir.ui.view">
        <field name="name">maintenance.request.search.almx.pedido.venta</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//search/field[1]" position="after">
                <field name="x_studio_field_ypPfL" string="Pedido de venta"/>
            </xpath>
        </field>
    </record>
</odoo>
