    <!-- 16: base.automation id 16 -->
    <record id="auto_16" model="base.automation">
        <field name="name">Create Maintenance Request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain">[["state","=","sale"]]</field>
        <field name="filter_pre_domain">["|",["state","=","draft"],["state","=","sent"]]</field>
    </record>
    <record id="auto_16_act0" model="ir.actions.server">
        <field name="name">Create Maintenance Request</field>
        <field name="model_id" eval="ref('sale.model_sale_order')"/>
        <field name="base_automation_id" eval="ref('auto_16')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for counter, line in enumerate(record.order_line.filtered(
        lambda l: l.product_id.recurring_invoice and l.product_id.x_studio_field_mmOq4 and l.product_id.x_studio_field_RhizH), 1):
    for count in range(1, int(line.product_uom_qty) + 1):
        # 19: name_get() ya no existe -> display_name
        request_name = ' - '.join((line.product_id.display_name, str(counter), str(count), line.order_id.partner_id.name))
        env['maintenance.request'].create({
            'name': request_name,
            'kanban_state': 'normal',
            'maintenance_team_id': line.product_id.x_studio_field_RhizH.id,
            'x_studio_field_UT6zf': line.id,
            'description': line.product_id.description_sale,
            'company_id': line.order_id.partner_id.company_id.id or line.order_id.company_id.id,
        })
        ]]></field>
    </record>

