    <!-- 16: base.automation id 96 -->
    <record id="auto_96" model="base.automation">
        <field name="name">Asignar Responsable Inst Mod</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[("state", "=", "sale")]</field>
        <field name="filter_pre_domain">[("state", "!=", "sale")]</field>
    </record>
    <record id="auto_96_act0" model="ir.actions.server">
        <field name="name">Asignar Responsable Inst Mod</field>
        <field name="model_id" eval="ref('sale.model_sale_order')"/>
        <field name="base_automation_id" eval="ref('auto_96')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
tarea_previa = env['project.task'].search([('sale_order_id', '=', record.id)], limit=1)

if record.state == 'sale' and not tarea_previa:
    project_id = False
    stage_id = False
    tipo_label = "Servicio" # Valor por defecto

    s_type = str(record.sale_type).lower() if record.sale_type else ""

    es_nuevo_check = False
    if 'x_studio_es_equipo_nuevo' in record._fields:
        es_nuevo_check = record.x_studio_es_equipo_nuevo

    if 'project' in s_type or es_nuevo_check:
        project_id = 8
        stage_id = 260
        tipo_label = "Instalación Nueva"

    else:
        es_mod_check = False
        if 'modernization' in record._fields:
            es_mod_check = record.modernization
        elif 'x_studio_modernization' in record._fields:
            es_mod_check = record.x_studio_modernization
        
        if 'mordern' in s_type or 'modern' in s_type or es_mod_check:
            project_id = 92
            stage_id = 271
            tipo_label = "Modernización"

    if project_id and stage_id:
        nueva_tarea = env['project.task'].create({
            'name': record.name + ' - ' + tipo_label,
            'project_id': project_id,
            'stage_id': stage_id,
            'user_ids': [(6, 0, [38552])],  # Saraí Martínez García
            'partner_id': record.partner_id.id,
            'sale_order_id': record.id,
            'description': record.note or '',
        })
        if nueva_tarea.sale_order_id.id != record.id:
            nueva_tarea.sudo().write({'sale_order_id': record.id})
        ]]></field>
    </record>

