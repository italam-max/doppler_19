<odoo>

    <!-- 16: base.automation id 135 -->
    <record id="auto_135" model="base.automation">
        <field name="name">Devoluciones: heredar SO de origen del OUT</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[('origin','like','Devoluci'),('picking_type_id.code','=','incoming')]</field>
    </record>
    <record id="auto_135_act0" model="ir.actions.server">
        <field name="name">Devoluciones: heredar SO de origen del OUT</field>
        <field name="model_id" eval="ref('stock.model_stock_picking')"/>
        <field name="base_automation_id" eval="ref('auto_135')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records:
    if record.sale_id or not record.origin:
        continue
    tokens = record.origin.replace('(', ' ').replace(')', ' ').split()
    out_name = False
    for tok in tokens:
        if '/OUT/' in tok:
            out_name = tok
            break
    if not out_name:
        continue
    out_picking = env['stock.picking'].search([('name', '=', out_name)], limit=1)
    if out_picking and out_picking.sale_id:
        record.write({'sale_id': out_picking.sale_id.id})
        ]]></field>
    </record>

