    <!-- 16: base.automation id 28 -->
    <record id="auto_28" model="base.automation">
        <field name="name">EBIRBE: Add salesman as follower on the service tasks - I#8289</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[["sale_order_id","!=",False]]</field>
    </record>
    <record id="auto_28_act0" model="ir.actions.server">
        <field name="name">EBIRBE: Add salesman as follower on the service tasks - I#8289</field>
        <field name="model_id" eval="ref('project.model_project_task')"/>
        <field name="base_automation_id" eval="ref('auto_28')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
salesman = record.sudo().sale_order_id.user_id.partner_id
record.sudo().message_subscribe(partner_ids=salesman.ids)
        ]]></field>
    </record>

    <!-- 16: base.automation id 136 -->
    <record id="auto_136" model="base.automation">
        <field name="name">Auto-suscribir mencionados (@) en tareas de Proyecto</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[('model','=','project.task'),('partner_ids','!=',False)]</field>
    </record>
    <record id="auto_136_act0" model="ir.actions.server">
        <field name="name">Auto-suscribir mencionados (@) en tareas de Proyecto</field>
        <field name="model_id" eval="ref('mail.model_mail_message')"/>
        <field name="base_automation_id" eval="ref('auto_136')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for message in records:
    if message.model == 'project.task' and message.res_id and message.partner_ids:
        task = env['project.task'].browse(message.res_id)
        if task.exists():
            missing = message.partner_ids - task.message_partner_ids
            if missing:
                task.message_subscribe(partner_ids=missing.ids)
        ]]></field>
    </record>

