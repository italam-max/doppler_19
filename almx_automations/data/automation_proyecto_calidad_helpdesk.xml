    <!-- 16: base.automation id 137 -->
    <record id="auto_137" model="base.automation">
        <field name="name">Helpdesk: bloquear cierre por no-miembro de la mesa</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain">[('stage_id.fold','=',True)]</field>
        <field name="filter_pre_domain">[('stage_id.fold','=',False)]</field>
    </record>
    <record id="auto_137_act0" model="ir.actions.server">
        <field name="name">Helpdesk: bloquear cierre por no-miembro de la mesa</field>
        <field name="model_id" eval="ref('helpdesk.model_helpdesk_ticket')"/>
        <field name="base_automation_id" eval="ref('auto_137')"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for record in records:
    if record.stage_id.fold:
        team = record.team_id
        is_member = bool(team) and env.user in team.member_ids
        if not is_member:
            team_name = team.name if team else 'sin mesa asignada'
            raise UserError("Solo los miembros de la mesa '%s' pueden cerrar este ticket." % team_name)
        ]]></field>
    </record>

