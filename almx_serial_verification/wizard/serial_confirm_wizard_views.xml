<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_almx_serial_confirm_wizard_form" model="ir.ui.view">
        <field name="name">almx.serial.confirm.wizard.form</field>
        <field name="model">almx.serial.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar números de serie">
                <div class="alert alert-info" role="alert">
                    Ingresa el número de serie que vas a entregar físicamente
                    para cada producto. El sistema lo verificará contra los
                    números de serie dados de alta antes de permitir validar.
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false"
                          decoration-success="is_valid"
                          decoration-danger="validation_message and not is_valid">
                        <field name="product_id" readonly="1"/>
                        <field name="location_id" readonly="1" string="Ubicación de origen"/>
                        <field name="entered_serial" string="Número de serie a entregar"/>
                        <field name="validation_message" string="Estado"/>
                        <field name="is_valid" column_invisible="True"/>
                        <field name="matched_lot_id" column_invisible="True"/>
                        <field name="move_line_id" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm_and_validate" string="Confirmar y validar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
