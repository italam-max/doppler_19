<odoo>
  <data>
    <!--Grupo "Puede validar pickings (NWH)". ALMX FIX (sept 2026, port a 19):
        antes se referenciaba como doppler.group_can_validate_picking_doppler
        (modulo doppler, no portado a 19). Se recrea aqui, propio de almx_stock,
        SOLO el grupo de NWH que es el que realmente se usa hoy (Doppler
        Elevadores). El de Alamex/WH (doppler.group_can_validate_picking_alamex)
        NO se recreo; ya no se usa ese almacen, y el codigo Python que lo
        consulta ya lo tolera (raise_if_not_found=False). Mismo criterio que
        no_validate_manual_picking arriba: nace vacio, sin eval de "users", se
        asigna manualmente desde Ajustes > Usuarios por un administrador.-->
    <record id="group_can_validate_picking_doppler" model="res.groups">
        <field name="name">Puede validar pickings (NWH)</field>
        <field name="comment">Usuarios autorizados para validar Picks/OUTs del almacen NWH (Doppler Elevadores). Controla el boton "Validar" en el formulario del picking.</field>
    </record>

    <!--Grupo para la validación manual de inventario.
        IMPORTANTE: este registro se creó manualmente en producción (2026-07) porque
        el código de button_validate() lo esperaba desde hace tiempo pero el grupo
        nunca llegó a instalarse, así que la restricción estuvo inactiva para todos hasta
        ese momento. Se dejó noupdate="1" en ir.model.data para que esta actualización
        del módulo NO reasigne los usuarios (se administran desde Ajustes > Usuarios).
        No agregar aquí un eval de "users" por defecto: si esta actualización se
        reinstala desde cero en otro ambiente, el grupo debe quedar vacío y ser
        asignado manualmente por un administrador, nunca al superusuario.-->
    <record id="no_validate_manual_picking" model="res.groups">
        <field name="name">No puede validar pickings manuales</field>
        <field name="comment">Restringe la validación de PICKs manuales (sin orden de venta asociada) sin autorización de líder/dirección.</field>
    </record>

    <!--Grupo de destinatarios de "Solicitar autorización". Independiente de quién
        PUEDE validar (almx_stock.group_can_validate_picking_doppler), ya que este
        grupo define solo a quién le llega el aviso cuando alguien pide autorización,
        ya que en la práctica no todos los que pueden validar deben recibir cada aviso
        (ej. administradores que sí pueden validar pero no dan seguimiento operativo diario).-->
    <record id="group_picking_authorization_notify" model="res.groups">
        <field name="name">Recibe solicitudes de autorización de PICK</field>
        <field name="comment">Usuarios que reciben la notificación cuando alguien usa el botón "Solicitar autorización" en un picking. No implica que puedan o no validar -- eso lo controla el grupo de Doppler (NWH) por separado.</field>
    </record>

    <!--Grupos de acceso para acceso completo y acceso parcial-->
    <record id="view_datos_partner_complete" model="res.groups">
        <field name="name">Acceso completo a información del Contacto (inventario)</field>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
    </record>
    <record id="access_complete" model="ir.model.access">
        <field name="name">Acceso completo a información del Contacto (inventario)</field>
        <field name="model_id" ref="model_stock_picking"/>
        <field name="group_id" ref="view_datos_partner_complete"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="view_datos_partner_partial" model="res.groups">
        <field name="name">Acceso parcial a información del Contacto (inventario)</field>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <record id="access_partial" model="ir.model.access">
        <field name="name">Acceso parcial a información del Contacto (inventario)</field>
        <field name="model_id" ref="model_stock_picking"/>
        <field name="group_id" ref="view_datos_partner_partial"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--Vista solo con información parcial del Contacto-->
    <record model="ir.ui.view" id="form_partner_only_dir_view">
        <field name="name">partner.only.direction.view</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type" invisible="True"/>
                        <field name="parent_id" invisible="True"/>
                        <!-- Por ahora no aceptado al momento de hacer upgrade a V16.
                        <label for="" name="address_name">
                            <b attrs="{'invisible': [('type', '!=', 'contact')]}">Company Address</b>
                            <b attrs="{'invisible': [('type', '!=', 'invoice')]}">Invoice Address</b>
                            <b attrs="{'invisible': [('type', '!=', 'delivery')]}">Delivery Address</b>
                            <b attrs="{'invisible': [('type', '!=', 'other')]}">Other Address</b>
                            <b attrs="{'invisible': [('type', '!=', 'private')]}">Private Address</b>
                            <b invisible="type != False">Address</b>
                        </label>
                        -->
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
                            <field name="city" placeholder="City" class="o_address_city" readonly="type == 'contact' and parent_id != False"/>
                            <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" readonly="type == 'contact' and parent_id != False" context="{'country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id != False"/>
                            <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" readonly="type == 'contact' and parent_id != False"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Agrega campos al formulario de stock.picking-->
    <record  id="stock_picking_form_inherit" model="ir.ui.view">
      <field name="name">stock_picking_form_inherit</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='picking_type_id']" position="before">
            <field name="is_in_group" invisible="1"/>
        </xpath>
        <xpath expr="//div[@name='button_box']" position="after">
            <div class="alert alert-info o_form_header position-relative" style="top: 0px; width: 100%;" role="alert" invisible="is_in_group == True">
              <a class="close" data-dismiss="alert" style="right: 0px;" href="#">x</a>
              <div class="text-center text-end o_not_full">
                <strong>Es necesario solicitar la validación del PICK con tu lider o dirección, ya que no cuentas con permisos suficientes.</strong>
              </div>
            </div>
        </xpath>
        <xpath expr="//field[@name='origin']" position="after">
          <field name="carrier_id" readonly="1"/>
          <field name="collect_date" readonly="1" invisible="is_immediate == False"/>
          <field name="is_immediate" invisible="1"/>
        </xpath>
        <xpath expr="//field[@name='origin']" position="after">
          <!-- ALMX (sept 2026, port a 19): se reemplaza is_paid (checkbox manual,
               no conectado a la SO) por los espejos de solo lectura de la SO.
               En 16 estos dos campos se mostraban via una vista de Studio que no
               sobrevivio la migracion. Venta pagada solo la edita Finanzas en la SO. -->
          <field name="x_studio_tipo_de_venta" readonly="1"/>
          <field name="x_studio_completamente_pagado" string="Venta pagada" readonly="1"/>
          <field name="is_account_manager" invisible="1"/>
          <!-- ALMX FIX (sept 2026, port a 19): se quitaron los 12 campos de
               "Material listo" (warehouse/store/lab/quality: _already, _date,
               _check); confirmado que no funcionaban de verdad en 16. -->
        </xpath>
        <xpath expr="//field[@name='is_immediate']" position="after">
            <field name="out_complement" invisible="picking_type_id != 37" force_save="1"/>
        </xpath>
        <!--
        <xpath expr="//field[@name='partner_to_ship']" position="after">
            <field name="partner_receives" invisible="picking_type_id != 37" force_save="1"/>
        </xpath>
        -->
        <xpath expr="//field[@name='partner_id']" position="after">
            <field name="not_validate" invisible="1"/>
        </xpath>
        <!-- partner_only_dir se coloca en su propia fila, con su propia etiqueta explícita.
             No comparte fila/label con partner_id: esa suposición (que nunca coexistirían)
             dejó de ser cierta desde que hay usuarios en ambos grupos de acceso a la vez.
             IMPORTANTE (2026-07): address_display se agregó al mismo grupo que partner_only_dir
             y su label. Antes address_display no tenía restricción, así que para usuarios sin
             view_datos_partner_partial (ej. Acceso completo en vez de parcial) solo desaparecían
             2 de los 3 elementos de este bloque, y eso descuadraba la cuadrícula de 2 columnas del
             formulario para el resto de los campos (picking_type_id y lo que sigue). Ahora los 3
             aparecen o desaparecen como una sola unidad, sin importar qué grupo tenga cada usuario. -->
        <xpath expr="//field[@name='picking_type_id']" position="before">
            <div class="o_td_label" groups="almx_stock.view_datos_partner_partial">
                <label for="partner_only_dir" groups="almx_stock.view_datos_partner_partial" string="Dirección de entrega"/>
            </div>
            <field name="partner_only_dir" nolabel="1" groups="almx_stock.view_datos_partner_partial" options="{'no_quick_create': True, 'no_create_edit' : True}" context="{'form_view_ref': 'almx_stock.form_partner_only_dir_view'}"/>
            <field name="address_display" string="Dirección completa" readonly="1" groups="almx_stock.view_datos_partner_partial"/>
        </xpath>
        <!-- Se quitó la restricción de grupo (almx_stock.view_datos_partner_complete) sobre partner_id:
             era la única razón de existir de ese grupo, no lograba nada útil (el campo alterno
             partner_only_dir no mostraba dirección completa de todos modos), y además entraba en
             conflicto con un context nativo de Odoo que referencia partner_id en la vista de líneas
             de movimiento, lo cual rompía la validación del módulo al hacer -u. -->
        <xpath expr="//button[@name='button_validate'][@class='oe_highlight']" position="attributes">
          <attribute name="groups">almx_stock.group_can_validate_picking_doppler</attribute>
            <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel') or not_validate</attribute>
          <!--<attribute name="invisible">[('is_paid', '=', False), ('x_studio_tipo_de_venta', '!=', 'spare')]</attribute>-->
        </xpath>
        <!-- IMPORTANTE (2026-07): la vista base de Odoo (stock.picking.form) trae DOS elementos
             <button name="button_validate">, uno visible en estado 'waiting'/'confirmed' y otro
             visible en el resto de estados (comportamiento nativo, no un error). El xpath de arriba
             sin índice solo modifica el primero, así que este bloque aplica la MISMA restricción de grupo
             al segundo, que se había quedado con el permiso nativo original (stock.group_stock_user,
             mucho más amplio) y por eso algunos usuarios seguían viendo "Validar" sin el grupo nuevo,
             dependiendo del estado del picking. -->
        <!-- NOTA (sept 2026, port a 19): se agrego "invisible" con not_validate
             tambien aqui. Antes solo el boton 1 (oe_highlight) tenia esta
             proteccion via almx_stock_extends; el boton 2 se quedaba con la
             regla de negocio incompleta (un picking en 'draft'/'confirmed'
             podia validarse sin pasar por not_validate). Se consolido y
             completo la regla en almx_stock, unica fuente de esta logica. -->
        <xpath expr="//button[@name='button_validate'][2]" position="attributes">
          <attribute name="groups">almx_stock.group_can_validate_picking_doppler</attribute>
          <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel') or not_validate</attribute>
        </xpath>
        <xpath expr="//button[@name='button_validate']" position="after">
            <field name="show_request_authorization" invisible="1"/>
            <button name="action_request_validation_authorization"
                    string="Solicitar autorización"
                    type="object"
                    class="btn-secondary"
                    confirm="Esto notificará a las personas autorizadas a validar. ¿Continuar?"
                    invisible="show_request_authorization == False"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>