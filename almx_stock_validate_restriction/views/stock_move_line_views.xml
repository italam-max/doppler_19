<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_operation_tree_availability" model="ir.ui.view">
        <field name="name">stock.move.line.operation.list.availability</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">is_available and state not in ('done', 'cancel')</attribute>
                <attribute name="decoration-danger">not is_available and state not in ('done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="is_available" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_availability" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.list.availability</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">is_available and state not in ('done', 'cancel')</attribute>
                <attribute name="decoration-danger">not is_available and state not in ('done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="is_available" column_invisible="True"/>
            </xpath>
        </field>
    </record>

</odoo>
