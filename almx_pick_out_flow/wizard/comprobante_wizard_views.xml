<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="almx_comprobante_wizard_form" model="ir.ui.view">
        <field name="name">almx.comprobante.wizard.form</field>
        <field name="model">almx.comprobante.wizard</field>
        <field name="arch" type="xml">
            <form string="Comprobante de entrega">
                <p>Para validar <strong><field name="picking_id" readonly="1" class="oe_inline"/></strong> sube el Comprobante: la hoja de entrega firmada por el cliente (PDF o foto). Sin Comprobante no se puede validar.</p>
                <group>
                    <field name="comprobante" filename="comprobante_filename"/>
                    <field name="comprobante_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Subir comprobante y validar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
