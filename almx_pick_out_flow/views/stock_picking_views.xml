<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda la vista de almx_stock donde ya viven las URLs de evidencia. -->
    <record id="view_picking_form_almx_pick_out_flow" model="ir.ui.view">
        <field name="name">stock.picking.form.almx.pick.out.flow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="almx_stock.stock_picking_form_inherit"/>
        <field name="arch" type="xml">
            <field name="x_studio_evidencia_fotogrfica" position="attributes">
                <attribute name="invisible">picking_type_code != 'outgoing' and not almx_is_pick</attribute>
                <attribute name="readonly">state in ('done', 'cancel') or almx_lock_url_almacen</attribute>
            </field>
            <field name="x_studio_url_bodega" position="attributes">
                <attribute name="invisible">picking_type_code != 'outgoing' and not almx_is_pick</attribute>
                <attribute name="readonly">state in ('done', 'cancel') or almx_lock_url_bodega</attribute>
            </field>
            <field name="x_studio_url_laboratorio" position="attributes">
                <attribute name="invisible">picking_type_code != 'outgoing' and not almx_is_pick</attribute>
                <attribute name="readonly">state in ('done', 'cancel') or almx_lock_url_laboratorio</attribute>
            </field>
            <field name="x_studio_url_calidad" position="after">
                <field name="almx_is_pick" invisible="1"/>
                <field name="almx_lock_url_almacen" invisible="1"/>
                <field name="almx_lock_url_bodega" invisible="1"/>
                <field name="almx_lock_url_laboratorio" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
