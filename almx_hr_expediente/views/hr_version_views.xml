<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_version_list_almx_expediente" model="ir.ui.view">
        <field name="name">hr.version.list.almx.expediente</field>
        <field name="model">hr.version</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Historial de contratos" editable="bottom" create="0" delete="0" default_order="date_version desc">
                <field name="employee_id" readonly="1" optional="hide"/>
                <field name="name" readonly="1" optional="hide"/>
                <field name="date_version" string="Vigente desde" readonly="1"/>
                <field name="contract_type_id" readonly="1" optional="show"/>
                <field name="contract_date_start" readonly="1"/>
                <field name="contract_date_end" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="wage" readonly="1" optional="show"/>
                <field name="x_studio_field_gRCXE" string="Contrato firmado" widget="binary" filename="x_studio_field_gRCXE_filename"/>
                <field name="x_studio_field_gRCXE_filename" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
