<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="almx_contract_change_wizard_form" model="ir.ui.view">
        <field name="name">almx.contract.change.wizard.form</field>
        <field name="model">almx.contract.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar movimiento de contrato">
                <field name="employee_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="Contrato vigente hoy">
                        <field name="current_date_version"/>
                        <field name="current_contract_type_id"/>
                        <field name="current_job_id"/>
                        <field name="current_period"/>
                        <field name="current_wage"/>
                    </group>
                    <group string="Nuevo movimiento">
                        <field name="movement_type" widget="radio"/>
                        <field name="date_version"/>
                        <field name="contract_type_id" options="{'no_create': True}"/>
                        <field name="contract_date_start" required="movement_type in ('nuevo', 'renovacion')"/>
                        <field name="contract_date_end"/>
                        <field name="job_id" options="{'no_create': True}"/>
                        <field name="wage"/>
                        <field name="signed_contract" filename="signed_contract_fname"/>
                        <field name="signed_contract_fname" invisible="1"/>
                    </group>
                </group>
                <field name="note" placeholder="Observaciones (opcional): motivo del cambio, quién lo autorizó, etc."/>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar movimiento" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
