<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_almx_expediente" model="ir.ui.view">
        <field name="name">hr.employee.form.almx.expediente</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='personal_information']" position="after">
                <page name="almx_expediente_rh" string="RRHH / Expediente" groups="almx_hr_expediente.group_expediente_rh">
                    <group>
                        <group string="Identificación">
                            <field name="x_studio_field_X5eU7" string="Acta de nacimiento" filename="x_studio_field_X5eU7_filename"/>
                            <field name="x_studio_field_X5eU7_filename" invisible="1"/>
                            <field name="x_studio_field_7yYos" string="CURP" filename="x_studio_field_7yYos_filename"/>
                            <field name="x_studio_field_7yYos_filename" invisible="1"/>
                            <field name="x_studio_field_qCV3k" string="Constancia de situación fiscal (RFC)" filename="x_studio_field_qCV3k_filename"/>
                            <field name="x_studio_field_qCV3k_filename" invisible="1"/>
                            <field name="x_studio_id_1" string="Identificación oficial" filename="x_studio_id_1_filename"/>
                            <field name="x_studio_id_1_filename" invisible="1"/>
                            <field name="x_studio_field_4fVwu" string="Comprobante de domicilio" filename="x_studio_field_4fVwu_filename"/>
                            <field name="x_studio_field_4fVwu_filename" invisible="1"/>
                            <field name="x_studio_drivers_license_1" string="Licencia de conducir" filename="x_studio_drivers_license_1_filename"/>
                            <field name="x_studio_drivers_license_1_filename" invisible="1"/>
                            <field name="x_studio_military_primer_1" string="Cartilla militar" filename="x_studio_military_primer_1_filename"/>
                            <field name="x_studio_military_primer_1_filename" invisible="1"/>
                        </group>
                        <group string="Seguridad social y créditos">
                            <field name="x_studio_field_Lc39r" string="Alta IMSS" filename="x_studio_field_Lc39r_filename"/>
                            <field name="x_studio_field_Lc39r_filename" invisible="1"/>
                            <field name="x_studio_field_hLRzJ" string="Documento NSS" filename="x_studio_field_hLRzJ_filename"/>
                            <field name="x_studio_field_hLRzJ_filename" invisible="1"/>
                            <field name="x_studio_field_PxX8o" string="INFONAVIT" filename="x_studio_field_PxX8o_filename"/>
                            <field name="x_studio_field_PxX8o_filename" invisible="1"/>
                            <field name="x_studio_field_yAgYM" string="FONACOT" filename="x_studio_field_yAgYM_filename"/>
                            <field name="x_studio_field_yAgYM_filename" invisible="1"/>
                        </group>
                        <group string="Ingreso">
                            <field name="x_studio_cv" string="CV" filename="x_studio_cv_filename"/>
                            <field name="x_studio_cv_filename" invisible="1"/>
                            <field name="x_studio_proof_of_studies" string="Comprobante de estudios" filename="x_studio_proof_of_studies_filename"/>
                            <field name="x_studio_proof_of_studies_filename" invisible="1"/>
                        </group>
                        <group string="Acuerdos firmados">
                            <field name="x_studio_confidenciality_agreement" string="Convenio de confidencialidad" filename="x_studio_confidenciality_agreement_filename"/>
                            <field name="x_studio_confidenciality_agreement_filename" invisible="1"/>
                            <field name="x_studio_job_description_agreement" string="Descripción de puesto" filename="x_studio_job_description_agreement_filename"/>
                            <field name="x_studio_job_description_agreement_filename" invisible="1"/>
                            <field name="x_studio_internal_reguations_agreement" string="Reglamento interior de trabajo" filename="x_studio_internal_reguations_agreement_filename"/>
                            <field name="x_studio_internal_reguations_agreement_filename" invisible="1"/>
                            <field name="x_studio_image_use_consent" string="Consentimiento de uso de imagen" filename="x_studio_image_use_consent_filename"/>
                            <field name="x_studio_image_use_consent_filename" invisible="1"/>
                        </group>
                        <group string="Psicometría">
                            <field name="almx_applicant_id" readonly="1"/>
                            <field name="almx_psico_test" filename="almx_psico_test_fname"/>
                            <field name="almx_psico_test_fname" invisible="1"/>
                            <field name="almx_psico_zavic" filename="almx_psico_zavic_fname"/>
                            <field name="almx_psico_zavic_fname" invisible="1"/>
                            <field name="almx_psico_rain" filename="almx_psico_rain_fname"/>
                            <field name="almx_psico_rain_fname" invisible="1"/>
                            <field name="almx_psico_machover" filename="almx_psico_machover_fname"/>
                            <field name="almx_psico_machover_fname" invisible="1"/>
                        </group>
                        <group string="Contrato vigente">
                            <field name="date_version" string="Último movimiento vigente desde" readonly="1"/>
                            <field name="contract_type_id" readonly="1"/>
                            <field name="job_id" string="Puesto" readonly="1"/>
                            <field name="contract_date_start" string="Inicio del contrato" readonly="1"/>
                            <field name="contract_date_end" string="Fin del contrato" readonly="1"/>
                            <field name="wage" string="Salario mensual" readonly="1"/>
                            <field name="x_studio_field_gRCXE" string="Contrato firmado" filename="x_studio_field_gRCXE_filename"/>
                            <field name="x_studio_field_gRCXE_filename" invisible="1"/>
                            <div colspan="2" class="d-flex gap-2 mt-2">
                                <button name="action_almx_contract_change" type="object" string="Registrar movimiento de contrato" icon="fa-file-text-o" class="btn-primary"/>
                                <button name="action_almx_contract_history" type="object" string="Historial de contratos" icon="fa-history" class="btn-secondary"/>
                            </div>
                            <div class="text-muted" colspan="2">Contrato nuevo, renovación, aumento o cambio de puesto: usa "Registrar movimiento de contrato". Queda en el historial y en el chatter con quién lo registró. La fecha de ingreso, antigüedad y contrato vigente también se ven en la pestaña Trabajo.</div>
                        </group>
                        <group string="Otros documentos" invisible="not x_studio_field_QxOXp and not x_studio_field_jH7fy and not x_studio_field_CqmyV">
                            <field name="x_studio_field_QxOXp" string="Pasaporte" filename="x_studio_field_QxOXp_filename"/>
                            <field name="x_studio_field_QxOXp_filename" invisible="1"/>
                            <field name="x_studio_field_jH7fy" string="Visa" filename="x_studio_field_jH7fy_filename"/>
                            <field name="x_studio_field_jH7fy_filename" invisible="1"/>
                            <field name="x_studio_field_CqmyV" string="Permiso de trabajo" filename="x_studio_field_CqmyV_filename"/>
                            <field name="x_studio_field_CqmyV_filename" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- La barra nativa de versiones (fechas + "+") no se usa: los movimientos van por el asistente -->
            <xpath expr="//header/field[@name='version_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='payroll_information']//field[@name='contract_type_id']" position="after">
                <field name="x_studio_field_gRCXE" string="Contrato firmado" filename="x_studio_field_gRCXE_filename"
                       groups="almx_hr_expediente.group_expediente_rh"/>
                <field name="x_studio_field_gRCXE_filename" invisible="1" groups="almx_hr_expediente.group_expediente_rh"/>
            </xpath>
        </field>
    </record>

    <!-- Ingreso y salida (pestaña Trabajo, grupo de almx_ajustes_v19) más completo -->
    <record id="hr_employee_form_almx_expediente_ingreso" model="ir.ui.view">
        <field name="name">hr.employee.form.almx.expediente.ingreso</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="almx_ajustes_v19.hr_employee_view_form_almx_ajustes"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='almx_ingreso_salida']" position="inside">
                <field name="almx_antiguedad" invisible="not almx_antiguedad"/>
                <field name="almx_contrato_vigente" groups="almx_hr_expediente.group_expediente_rh"/>
                <field name="almx_ultimo_movimiento" groups="almx_hr_expediente.group_expediente_rh"/>
                <div colspan="2" class="d-flex gap-3" groups="almx_hr_expediente.group_expediente_rh">
                    <button name="action_almx_contract_change" type="object" string="Registrar movimiento" icon="fa-file-text-o" class="btn-link p-0"/>
                    <button name="action_almx_contract_history" type="object" string="Historial de contratos" icon="fa-history" class="btn-link p-0"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
